# ─── Configuración del Bot ───────────────────────────────────────────────────
# Copiá este archivo como ".env" y completá los valores

# Token del bot (obtenelo en discord.com/developers/applications > Tu App > Bot > Token)
TOKEN=PEGA_TU_TOKEN_AQUI

# ID de tu aplicación (obtenelo en discord.com/developers/applications > Tu App > General Information > Application ID)
CLIENT_ID=PEGA_TU_CLIENT_ID_AQUI
